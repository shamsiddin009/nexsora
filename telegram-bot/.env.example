# Nexsora Telegram Bot — Server Environment Variables
# Bu faylni nusxalab ".env" deb saqlang va haqiqiy qiymatlarni qo'ying
# .env fayli .gitignore'da — HECH QACHON git'ga qo'shmang!

# BotFather'dan olingan token
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Supabase (bot'ga kerak bo'lsa)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_service_key_here
